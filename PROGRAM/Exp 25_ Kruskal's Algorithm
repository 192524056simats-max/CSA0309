#include <stdio.h>

struct edge
{
    int u, v, w;
};

int find(int parent[], int x)
{
    while(parent[x] != x)
        x = parent[x];
    return x;
}

int main()
{
    struct edge e[20], temp;
    int parent[10], n, m, i, j, count = 0, cost = 0;

    printf("Enter number of vertices: ");
    scanf("%d", &n);

    printf("Enter number of edges: ");
    scanf("%d", &m);

    printf("Enter edges (u v weight):\n");
    for(i = 0; i < m; i++)
        scanf("%d%d%d", &e[i].u, &e[i].v, &e[i].w);

    for(i = 0; i < m - 1; i++)
        for(j = i + 1; j < m; j++)
            if(e[i].w > e[j].w)
            {
                temp = e[i];
                e[i] = e[j];
                e[j] = temp;
            }

    for(i = 0; i < n; i++)
        parent[i] = i;

    printf("Edges in MST:\n");

    for(i = 0; i < m && count < n - 1; i++)
    {
        int a = find(parent, e[i].u);
        int b = find(parent, e[i].v);

        if(a != b)
        {
            printf("%d - %d = %d\n", e[i].u, e[i].v, e[i].w);
            cost += e[i].w;
            parent[a] = b;
            count++;
        }
    }

    printf("Total Cost = %d", cost);

    return 0;
}
