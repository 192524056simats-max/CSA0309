#include <stdio.h>

#define INF 9999

int main()
{
    int a[10][10], visited[10] = {0};
    int n, i, j, u, v, min, cost = 0;

    printf("Enter number of vertices: ");
    scanf("%d", &n);

    printf("Enter weighted adjacency matrix:\n");
    for(i = 0; i < n; i++)
        for(j = 0; j < n; j++)
            scanf("%d", &a[i][j]);

    visited[0] = 1;

    printf("Edges in MST:\n");

    for(i = 0; i < n - 1; i++)
    {
        min = INF;

        for(j = 0; j < n; j++)
        {
            if(visited[j])
            {
                for(int k = 0; k < n; k++)
                {
                    if(!visited[k] && a[j][k] < min && a[j][k] != 0)
                    {
                        min = a[j][k];
                        u = j;
                        v = k;
                    }
                }
            }
        }

        printf("%d - %d = %d\n", u, v, min);
        cost += min;
        visited[v] = 1;
    }

    printf("Total Cost = %d", cost);

    return 0;
}
